rules_version = '2';

// AFRIFF database rules: who can read and change what.
// Deploy with `npm run deploy:rules` whenever it changes (or paste it into
// Firebase console → Firestore → Rules → Publish).
//
// Roles live in users/{uid}.role:
//   pending   – signed up, no access yet (an admin must give a role)
//   admin     – everything, approves editors' changes, manages the team
//   editor    – proposes changes (they wait in "changes" for approval)
//   volunteer – updates queue counts for their own venue only
//
// ATTENDEES (people using the festival app) are a separate kind of sign-in:
// their Firebase sign-in carries `attendee: true` (set by the staff app's
// server after it checks their PIN, apps/admin/server/accounts/). They never
// have a team role, can't create one, and can only touch their own My Festival.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() {
      return signedIn() && exists(profilePath()) ? get(profilePath()).data.role : 'none';
    }
    function isAdmin() { return role() == 'admin'; }
    function isEditor() { return role() == 'editor'; }
    function myVenue() { return get(profilePath()).data.venue; }
    function isAttendee() { return signedIn() && request.auth.token.get('attendee', false) == true; }

    // ---------- Team members ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // New sign-ups create their own profile, always with no access.
      allow create: if signedIn() && !isAttendee() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'venue', 'createdAt'])
        && request.resource.data.role == 'pending'
        && request.resource.data.venue == null;
      // Only admins change roles and venues; people can fix their own name.
      allow update: if isAdmin()
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();
    }

    // ---------- Live festival data (what attendees see) ----------
    // Anyone can read. Only admins write directly; editors go through "changes".
    match /films/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /screenings/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /venues/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /sponsors/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /howToAttend/{id} { allow read: if true; allow write: if isAdmin(); }
    match /jury/{id}        { allow read: if true; allow write: if isAdmin(); }

    // ---------- What attendees' phones download ----------
    // Written by an admin's "Publish to app" button: the bundle (published/current)
    // and a tiny marker (published/version) that open phones watch live, read
    // directly with the Firebase SDK. Anyone can read; only admins write.
    match /published/{id}   { allow read: if true; allow write: if isAdmin(); }

    // ---------- Push notifications already sent ----------
    // pushLog/{newsId}: one record per announcement sent (or skipped) as a push
    // notification, so it's never sent twice. Written only by the staff app's
    // server (Admin SDK, which these rules don't apply to); admins read it to
    // see what the next publish will send.
    match /pushLog/{id}     { allow read: if isAdmin(); allow write: if false; }

    // ---------- The afriff.com sync (Cloud Function syncFromAfriff) ----------
    // sync/afriff: what its last check did (the console's "afriff.com sync" card);
    // sync/afriff-baseline: what afriff.com said last time. Written only by the
    // function (Admin SDK, which these rules don't apply to). Its run logs,
    // syncRuns/{id}, have no rule, so only the Firebase console shows them.
    match /sync/{id}        { allow read: if isAdmin(); allow write: if false; }

    // ---------- Changes waiting for an admin's approval ----------
    match /changes/{id} {
      allow read: if isAdmin() || (isEditor() && resource.data.submittedBy == request.auth.uid);
      allow create: if (isEditor() || isAdmin())
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---------- Anonymous counts from attendees' phones (for Reports) ----------
    // Phones (not logged in) can write only their own small record with these
    // fields; only admins can read them.
    match /usage/{deviceId} {
      allow read, delete: if isAdmin();
      allow create, update: if deviceId.size() <= 64
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'planned', 'seen', 'days'])
        && request.resource.data.planned is list && request.resource.data.planned.size() <= 400
        && request.resource.data.seen is map && request.resource.data.seen.size() <= 300
        && request.resource.data.days is list && request.resource.data.days.size() <= 60;
    }

    // ---------- Attendee accounts ----------
    // attendees/{uid}: the "App users" list (name, email, whether they said yes
    // to festival emails). Only ADMINS can read it (console → Attendees); each
    // person can read their own. Editors and door volunteers can't. Written only
    // by the staff app's server.
    match /attendees/{uid} {
      allow read: if isAdmin() || (isAttendee() && request.auth.uid == uid);
      allow write: if false;
    }
    // attendeePlans/{uid}: someone's My Festival, so it follows them to another
    // phone. Only they can read or write it, only while their account exists,
    // only these fields, within these sizes (packages/core/src/accounts/plans.ts).
    match /attendeePlans/{uid} {
      allow read: if isAttendee() && request.auth.uid == uid;
      allow create, update: if isAttendee() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/attendees/$(uid))
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'scheduled', 'watched', 'queuesChecked'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.scheduled is list && request.resource.data.scheduled.size() <= 500
        && request.resource.data.watched is map && request.resource.data.watched.size() <= 400
        && request.resource.data.queuesChecked is list && request.resource.data.queuesChecked.size() <= 2000;
      allow delete: if false;
    }
    // settings/attendeeAccounts: the console's "Require sign-up" switch (admins).
    // The staff app's server reads it and tells phones.
    match /settings/{id} { allow read, write: if isAdmin(); }
    // attendeeSecrets (scrambled PINs, emailed codes, wrong-PIN counts),
    // attendeeEmails (one entry per email) and authLimits (wrong tries per
    // network) have NO rule on purpose: no app can read or write them, only the
    // staff app's server (Admin SDK).

    // ---------- Live queue counts ----------
    // One record per venue per festival day: queueDays/{date}/venues/{venueId},
    // holding every screening's count at that venue that day. Anyone can read
    // (phones listen to it directly). Volunteers can only write their own venue.
    match /queueDays/{date}/venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin()
        || (role() == 'volunteer' && venueId == myVenue()
            && request.resource.data.venue == venueId
            && request.resource.data.date == date);
    }
  }
}
