{
  "name": "afriff",
  "private": true,
  "type": "module",
  "description": "AFRIFF festival companion monorepo: the attendee PWA, the staff console, and the shared packages both are built from.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:pwa",
    "dev:pwa": "npm run dev -w afriff-pwa",
    "dev:admin": "npm run dev -w afriff-admin",
    "build": "npm run build:pwa && npm run build:admin",
    "build:pwa": "npm run build -w afriff-pwa",
    "build:admin": "npm run build -w afriff-admin",
    "preview:pwa": "npm run preview -w afriff-pwa",
    "preview:admin": "npm run preview -w afriff-admin -- --port 3001",
    "typecheck": "npm run typecheck -w afriff-pwa && npm run typecheck -w afriff-admin",
    "demo:logins": "node scripts/demo-logins.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules --project afriff-app",
    "deploy:functions": "firebase deploy --only functions --project afriff-app"
  },
  "engines": {
    "node": ">=20.19"
  }
}
