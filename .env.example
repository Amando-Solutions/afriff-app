# Optional. The app works without a .env: it defaults to the live AFRIFF
# Firebase project (see runtimeConfig in nuxt.config.ts). Set these only to
# point a build at a different Firebase project, e.g. a test copy.
# They're public identifiers, not secrets.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
