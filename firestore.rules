rules_version = '2';

// AFRIFF database rules: who can read and change what.
// Deploy with `npm run deploy:rules` whenever it changes (or paste it into
// Firebase console → Firestore → Rules → Publish).
//
// Roles live in users/{uid}.role:
//   pending   – signed up, no access yet (an admin must give a role)
//   admin     – everything, approves editors' changes, manages the team
//   editor    – proposes changes (they wait in "changes" for approval)
//   volunteer – updates queue counts for their own venue only
//
// SUPERADMINS (the app's two owners) are not a role: their profile says
// 'admin', so admins can't see the difference. It comes from their confirmed
// sign-in email (superadminEmails() below; apps/admin/shared/team.ts has the
// same list). Admins can make someone an admin; only superadmins can take
// admin access away. A superadmin always stays one (their console puts their
// profile back to 'admin' if anyone changes it).
//
// ATTENDEES (people using the festival app) sign in with Firebase's own email
// + password, like the team. So a sign-in alone says nothing: team rights come
// only from users/{uid}.role, attendee records only from attendees/{uid}. One
// person can have both (a team member who also plans their festival).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() {
      return signedIn() && exists(profilePath()) ? get(profilePath()).data.role : 'none';
    }
    // A confirmed email only: anyone can create a login with an unconfirmed one.
    function superadminEmails() { return ['michaelakpuofoba@gmail.com', 'tithera14@gmail.com']; }
    function isSuperadmin() {
      return signedIn() && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() in superadminEmails();
    }
    function isAdmin() { return isSuperadmin() || role() == 'admin'; }
    function isEditor() { return role() == 'editor'; }
    function myVenue() { return get(profilePath()).data.venue; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function myEmail() { return request.auth.token.email.lower(); }

    // ---------- Team members ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // New sign-ups create their own profile, always with no access, under their own email.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'venue', 'createdAt'])
        && request.resource.data.email == request.auth.token.get('email', null)
        && request.resource.data.role == 'pending'
        && request.resource.data.venue == null;
      // An admin's or a superadmin's profile: admins can't change or remove it.
      function adminProfile() {
        return resource.data.role == 'admin'
          || (resource.data.get('email', null) is string && resource.data.email.lower() in superadminEmails());
      }
      function teamRole() { return request.resource.data.role in ['pending', 'volunteer', 'editor', 'admin']; }
      // Admins change roles and venues of anyone who isn't an admin (making
      // them an admin too); only superadmins change an admin's. People can fix
      // their own name.
      allow update: if (isSuperadmin() && teamRole())
        || (isAdmin() && !adminProfile() && teamRole())
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isSuperadmin() || (isAdmin() && !adminProfile());
    }

    // ---------- Live festival data (what attendees see) ----------
    // Anyone can read. Only admins write directly; editors go through "changes".
    match /films/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /screenings/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /venues/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /sponsors/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /howToAttend/{id} { allow read: if true; allow write: if isAdmin(); }
    match /jury/{id}        { allow read: if true; allow write: if isAdmin(); }

    // ---------- What attendees' phones download ----------
    // Written by an admin's "Publish to app" button: the bundle (published/current)
    // and a tiny marker (published/version) that open phones watch live, read
    // directly with the Firebase SDK. Anyone can read; only admins write.
    match /published/{id}   { allow read: if true; allow write: if isAdmin(); }

    // ---------- Push notifications already sent ----------
    // pushLog/{newsId}: one record per announcement sent (or skipped) as a push
    // notification, so it's never sent twice. Written only by the staff app's
    // server (Admin SDK, which these rules don't apply to); admins read it to
    // see what the next publish will send.
    match /pushLog/{id}     { allow read: if isAdmin(); allow write: if false; }

    // ---------- The afriff.com sync (Cloud Function syncFromAfriff) ----------
    // sync/afriff: what its last check did (the console's "afriff.com sync" card);
    // sync/afriff-baseline: what afriff.com said last time. Written only by the
    // function (Admin SDK, which these rules don't apply to). Its run logs,
    // syncRuns/{id}, have no rule, so only the Firebase console shows them.
    match /sync/{id}        { allow read: if isAdmin(); allow write: if false; }

    // ---------- Changes waiting for an admin's approval ----------
    match /changes/{id} {
      allow read: if isAdmin() || (isEditor() && resource.data.submittedBy == request.auth.uid);
      allow create: if (isEditor() || isAdmin())
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---------- Anonymous counts from attendees' phones (for Reports) ----------
    // Phones (not logged in) can write only their own small record with these
    // fields; only admins can read them.
    match /usage/{deviceId} {
      allow read, delete: if isAdmin();
      allow create, update: if deviceId.size() <= 64
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'planned', 'seen', 'days'])
        && request.resource.data.planned is list && request.resource.data.planned.size() <= 400
        && request.resource.data.seen is map && request.resource.data.seen.size() <= 300
        && request.resource.data.days is list && request.resource.data.days.size() <= 60;
    }

    // ---------- Attendee accounts ----------
    // attendees/{uid}: the "App users" list (name, email, whether they said yes
    // to festival emails). Created by the person's phone when they sign up
    // (apps/pwa/app/lib/firebase/account.ts), every field checked here. ADMINS
    // and EDITORS can read the list (console → Contacts, for invitations; since
    // 27 Oct); each person can read their own. Door volunteers can't. The
    // Attendees page (delete, spreadsheets) stays admins-only. The person can change only
    // their emails choice (so can an email's unsubscribe link, through the staff
    // app's server).
    function newAttendeeOk() {
      let d = request.resource.data;
      let fields = ['firstName', 'lastName', 'email', 'emailLower', 'marketing', 'optInAtSignUp', 'consentText',
                    'marketingChangedAt', 'createdAt', 'createdDay', 'lastLoginAt'];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 60
        && d.lastName is string && d.lastName.size() > 0 && d.lastName.size() <= 60
        && d.email is string && d.email.lower() == myEmail()
        && d.emailLower == myEmail()
        && d.marketing is bool
        && d.optInAtSignUp == (d.marketing ? 1 : 0)
        && d.consentText is string && d.consentText.size() <= 200
        && d.marketingChangedAt == request.time && d.createdAt == request.time && d.lastLoginAt == request.time
        && d.createdDay is string && d.createdDay.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function attendeeChangeOk() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['marketing', 'consentText', 'marketingChangedAt', 'lastLoginAt'])
        && d.marketing is bool
        && d.consentText is string && d.consentText.size() <= 200
        && (!changed.hasAny(['marketing']) || d.marketingChangedAt == request.time)
        && (!changed.hasAny(['marketingChangedAt']) || d.marketingChangedAt == request.time)
        && (!changed.hasAny(['lastLoginAt']) || d.lastLoginAt == request.time);
    }
    match /attendees/{uid} {
      allow read: if isAdmin() || isEditor() || isSelf(uid);
      allow create: if isSelf(uid) && newAttendeeOk();
      allow update: if isSelf(uid) && attendeeChangeOk();
      allow delete: if isAdmin() || isSelf(uid);
    }
    // attendeePlans/{uid}: someone's My Festival, so it follows them to another
    // phone. Only they can read or write it, only while their account exists,
    // only these fields, within these sizes (packages/core/src/accounts/plans.ts).
    match /attendeePlans/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && exists(/databases/$(database)/documents/attendees/$(uid))
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'scheduled', 'watched', 'queuesChecked'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.scheduled is list && request.resource.data.scheduled.size() <= 500
        && request.resource.data.watched is map && request.resource.data.watched.size() <= 400
        && request.resource.data.queuesChecked is list && request.resource.data.queuesChecked.size() <= 2000;
    }
    // emails/{id}: festival emails sent from the console (Festival emails page):
    // what was sent, by whom, and how far sending got. Written only by the staff
    // app's server (Admin SDK), which also does the sending; admins read them.
    match /emails/{id} {
      allow read: if isAdmin();
    }

    // ---------- Contacts, groups, VIP links, invitations (console → Contacts, Invitations) ----------
    function isStaff() { return isAdmin() || isEditor(); }

    // groups/{id}: "Gala VIPs", "Opening night", "Press"… (members are listed on contacts)
    match /groups/{id} { allow read, write: if isStaff(); }

    // vipLinks/{code}: a private sign-up link for one group. The code IS the
    // secret (long and random): anyone holding the link may read that one
    // record (the app's /vip/<code> page says "You're invited: …"); nobody but
    // admins can list them. Only admins make, switch off or delete them.
    match /vipLinks/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // contacts/{key}: AFRIFF's own record about someone (groups, VIP, notes;
    // a guest added by hand: their details). key = their email, lower case.
    // Admins and editors read and write them. A phone signed in with that
    // email may add itself to ONE group, through a VIP link that's switched
    // on, unless an admin took them out of that group; nothing else
    // (apps/pwa/app/lib/firebase/vip.ts).
    function vipLink(code) { return get(/databases/$(database)/documents/vipLinks/$(code)).data; }
    function vipJoinOk(key, before, blocked) {
      let d = request.resource.data;
      return signedIn() && key == myEmail()
        && d.lastLink is string && d.lastLink.size() >= 16 && d.lastLink.size() <= 64
        && exists(/databases/$(database)/documents/vipLinks/$(d.lastLink))
        && vipLink(d.lastLink).active == true
        && !(vipLink(d.lastLink).group in blocked)
        && d.groups is list
        && d.groups.toSet() == before.toSet().union([vipLink(d.lastLink).group].toSet())
        && d.vip == true && d.uid == request.auth.uid && d.joinedAt == request.time;
    }
    match /contacts/{key} {
      allow read, delete: if isStaff();
      allow create: if isStaff()
        || (vipJoinOk(key, [], []) && request.resource.data.keys().hasOnly(['groups', 'vip', 'uid', 'lastLink', 'joinedAt']));
      allow update: if isStaff()
        || (vipJoinOk(key, resource.data.get('groups', []), resource.data.get('removedFrom', []))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groups', 'vip', 'uid', 'lastLink', 'joinedAt']));
    }

    // invites/{id}: invitations. Admins and editors write them while they're a
    // draft or waiting for approval, only these fields. Sending, scheduling and
    // what comes after are the staff app's server's (Admin SDK), for ADMINS
    // ONLY (server/invites/logic.ts): no one can mark an invite sent from here.
    function inviteFields() {
      return ['kind', 'parentId', 'subject', 'artworkUrl', 'message', 'event', 'audience',
              'status', 'reviewNote', 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'updatedBy', 'updatedByName'];
    }
    match /invites/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(inviteFields())
        && request.resource.data.status in ['draft', 'review']
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isStaff()
        && resource.data.status in ['draft', 'review']
        && request.resource.data.status in ['draft', 'review']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(inviteFields())
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isStaff() && resource.data.status in ['draft', 'review'];
      // the guest list (who it went to): admins only
      match /recipients/{key} { allow read: if isAdmin(); }
    }
    // settings/attendeeAccounts: the console's "Require an account to save to
    // My Festival" switch. Every phone reads it as the app starts; admins change it.
    match /settings/{id} {
      allow read: if id == 'attendeeAccounts' || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- Live queue counts ----------
    // One record per venue per festival day: queueDays/{date}/venues/{venueId},
    // holding every screening's count at that venue that day. Anyone can read
    // (phones listen to it directly). Volunteers can only write their own venue.
    match /queueDays/{date}/venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin()
        || (role() == 'volunteer' && venueId == myVenue()
            && request.resource.data.venue == venueId
            && request.resource.data.date == date);
    }
  }
}
