{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "test",
        "build.mjs",
        "tsconfig.json",
        "*.local",
        "firebase-debug.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run typecheck",
        "npm --prefix \"$RESOURCE_DIR\" test",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
