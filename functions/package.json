{
  "name": "afriff-functions",
  "private": true,
  "type": "module",
  "description": "AFRIFF Cloud Functions. syncFromAfriff: every 15 minutes, reads afriff.com's film list and brings the films in Firestore up to date, without overwriting what the team edited. Deployed with the Firebase CLI; not part of the npm workspaces (its own lockfile).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsx src/check.ts",
    "deploy": "firebase deploy --only functions --project afriff-app",
    "logs": "firebase functions:log --only syncFromAfriff --project afriff-app"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
