# Optional. Both apps work without a .env: they default to the live AFRIFF
# Firebase project (packages/core/nuxt.config.ts). Copy what you need into
# apps/pwa/.env and/or apps/admin/.env, or set them on the host (Vercel)
# BEFORE building: they're written into the app at build time, so redeploy
# after changing one on Vercel.

# SHARED (both apps): point a build at a different Firebase project (e.g. a
# test copy). Public identifiers, not secrets. On Vercel, add them once as
# Shared Environment Variables (Team Settings → Environment Variables) linked
# to both projects. A project's own variable with the same name wins over the
# shared one, so don't also add these per project.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# ATTENDEE APP ONLY (apps/pwa): the staff console's address. Old /admin,
# /door, #/admin and #/door links on the attendee app forward there.
# Required in production; defaults to http://localhost:3001 in dev.
NUXT_PUBLIC_ADMIN_URL=

# STAFF APP ONLY (apps/admin): the attendee app's address, for "View the
# attendee app" links. Defaults to https://afriff-app-mu.vercel.app.
NUXT_PUBLIC_ATTENDEE_URL=

# ---------------------------------------------------------------------------
# PUSH NOTIFICATIONS for announcements (both needed; without them the app
# works as before and the "Alerts on this phone" switch stays hidden).
# ---------------------------------------------------------------------------
# ATTENDEE APP ONLY: the public Web Push key. Firebase console → Project
# settings → Cloud Messaging → Web configuration → Web Push certificates →
# Generate key pair, then copy the "Key pair" value. Public, not a secret.
# Written into the app at build time: redeploy after setting it.
NUXT_PUBLIC_FIREBASE_VAPID_KEY=

# STAFF APP ONLY, SECRET: the service-account key that lets the staff app's
# server send notifications. Firebase console → Project settings → Service
# accounts → Generate new private key; paste the WHOLE downloaded .json file
# (one line is fine; base64 of it works too). Never commit it, never in a
# NUXT_PUBLIC_ variable. On Vercel: staff project only, marked Sensitive.
# Read at run time (no rebuild needed, but redeploy after changing it).
NUXT_FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# ATTENDEE ACCOUNTS (sign-up before using the app). Without the PIN secret and
# NUXT_FIREBASE_SERVICE_ACCOUNT (above), accounts are off and the attendee app
# lets everyone in ("Continue for now"). Details: DEVELOPER.md "Attendee accounts".
# ---------------------------------------------------------------------------
# STAFF APP ONLY, SECRET: the key every PIN is mixed with before it's
# scrambled, so a copy of the database is useless without it. Any long random
# text, at least 16 characters (e.g. the output of `openssl rand -base64 32`).
# NEVER CHANGE IT once people have signed up: every saved PIN would stop
# working. Never commit it. On Vercel: staff project only, marked Sensitive.
NUXT_ATTENDEE_PIN_SECRET=

# STAFF APP ONLY: Brevo (AFRIFF's email service).
# API key (SECRET): Brevo → SMTP & API → API keys.
NUXT_BREVO_API_KEY=
# The "from" address of the Forgot PIN code email. Must be on a domain
# verified in Brevo (Senders, Domains & Dedicated IPs), e.g. app@afriff.com.
NUXT_BREVO_SENDER_EMAIL=
NUXT_BREVO_SENDER_NAME=AFRIFF
# The number of the "App subscribers" list (Brevo → Contacts → Lists). Only
# people who tick "Yes, AFRIFF can email me festival news and updates" join it.
NUXT_BREVO_LIST_ID=
# Optional: a Brevo double opt-in template's number. When set, Brevo first
# emails a confirm link and adds them to the list once they click it.
NUXT_BREVO_DOI_TEMPLATE_ID=
# Optional: where that confirm link lands (default: the attendee app).
NUXT_BREVO_DOI_REDIRECT_URL=

# ATTENDEE APP ONLY: where people write to have their account deleted or ask
# what's kept about them (sign-up page and /privacy). AFRIFF to confirm.
# Empty: those pages point to afriff.com instead. Public, built into the app.
NUXT_PUBLIC_PRIVACY_EMAIL=
